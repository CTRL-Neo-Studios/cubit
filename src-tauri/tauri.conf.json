{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cubit",
  "version": "0.1.0",
  "identifier": "dev.ctrl-neo.cubit",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Cubit",
        "width": 600,
        "height": 300,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "windowEffects": {
          "effects": ["acrylic", "underWindowBackground"],
          "radius": 10
        },
        "center": true,
        "shadow": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
